# Vorlage für die .env auf dem IONOS-Webspace (Ordner der Anwendung, NICHT in public/).
# Siehe docs/betrieb-ionos.md

APP_NAME=Anliego
APP_ENV=production
# Erzeugen mit: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_DEBUG=false
APP_URL=https://tickets.example.de
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Berlin

LOG_CHANNEL=daily
LOG_LEVEL=warning

# IONOS: Hosting → Datenbanken → MariaDB/MySQL
DB_CONNECTION=mariadb
DB_HOST=dbXXXXXXXX.hosting-data.io
DB_PORT=3306
DB_DATABASE=dbsXXXXXXXX
DB_USERNAME=dbuXXXXXXXX
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Absender für Systemmails (Passwort vergessen, Benachrichtigungen)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.ionos.de
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.de
MAIL_FROM_NAME="${APP_NAME}"

# Zwei-Faktor-Anmeldung: freiwillig (false) oder für alle Mitarbeiter Pflicht (true)
ANLIEGO_MFA_PFLICHT=false
# Erzeugen mit: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;" – derselbe Wert als GitHub-Secret
ANLIEGO_DEPLOY_TOKEN=
ANLIEGO_CRON_WARNING_MINUTES=10

# Nur für die Ersteinrichtung: erster Administrator. Nach dem ersten Deploy wieder löschen!
ANLIEGO_INITIAL_ADMIN_NAME="Administrator"
ANLIEGO_INITIAL_ADMIN_EMAIL=
ANLIEGO_INITIAL_ADMIN_PASSWORD=
